# Bearer token required on every API route. No default; the server refuses to start without it.
MIGRATOR_AUTH_TOKEN=

# Absolute path to the durable job/store root. No default; must be an existing writable directory.
MIGRATOR_STORE_ROOT=

# Container runtime used to launch disposable validation sandboxes.
MIGRATOR_CONTAINER_RUNTIME=docker

# Admitted target profile identifier (see profiles/angular20/candidate.json).
MIGRATOR_PROFILE=angular20

# HTTP bind address and port.
MIGRATOR_HOST=127.0.0.1
MIGRATOR_PORT=3000
