{
    "name": "xelops-ai-migrator",
    "version": "0.1.0",
    "description": "Backend service that migrates React/Angular frontends to the Xelops Angular component library.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.15.0 <25.0.0"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit --project tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run tests/unit",
        "test:contract": "vitest run tests/contract",
        "test:integration": "vitest run tests/integration",
        "test:generated-project": "vitest run tests/generated-project"
    },
    "dependencies": {
        "@angular/compiler": "20.3.31",
        "@fastify/multipart": "10.1.1",
        "@fastify/rate-limit": "11.2.0",
        "@fastify/sensible": "6.0.5",
        "archiver": "8.0.0",
        "fastify": "5.12.5",
        "pino": "10.3.1",
        "postcss": "8.5.28",
        "postcss-scss": "4.0.9",
        "postcss-selector-parser": "7.1.6",
        "postcss-value-parser": "4.2.0",
        "yauzl": "3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/archiver": "8.0.0",
        "@types/node": "24.13.5",
        "@types/yauzl": "3.4.0",
        "@types/yazl": "3.3.1",
        "eslint": "10.10.0",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vitest": "5.0.1",
        "yazl": "3.3.1"
    }
}
